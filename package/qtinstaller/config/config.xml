<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>Traintastic</Name>
    <Version>1.0.0</Version>
    <Title>Traintastic Installer</Title>
    <Publisher>Reinder Feenstra</Publisher>
    <ProductUrl>https://traintastic.org</ProductUrl>
    <Logo>logo.svg</Logo>
    <InstallerApplicationIcon>installer-icon</InstallerApplicationIcon>
    <InstallerWindowIcon>InstallerLogo.svg</InstallerWindowIcon>
    <StartMenuDir>Traintastic</StartMenuDir>
    <TargetDir>@ApplicationsDir@/Traintastic</TargetDir>
    <AdminTargetDir>@RootDir@/Program Files/Traintastic</AdminTargetDir>
    <RemoteRepositories>
    <Repository>
        <Url>https://kamil00110.github.io/6050-6023-interface/repository/release</Url>
        <DisplayName>Release Builds (Stable)</DisplayName>
        <Enabled>1</Enabled>
    </Repository>
    <Repository>
        <Url>https://kamil00110.github.io/6050-6023-interface/repository/developer</Url>
        <DisplayName>Developer Builds (Latest)</DisplayName>
        <Enabled>0</Enabled>
    </Repository>
    </RemoteRepositories>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <WizardStyle>Modern</WizardStyle>
    <TitleColor>#FFFFFF</TitleColor>
    <RunProgram>@TargetDir@/client/traintastic-client.exe</RunProgram>
    <RunProgramDescription>Launch Traintastic Client</RunProgramDescription>
    <MaintenanceToolName>TraintasticMaintenanceTool</MaintenanceToolName>
    <CreateLocalRepository>true</CreateLocalRepository>
    <Translations>
        <Translation>en_US</Translation>
        <Translation>nl_NL</Translation>
        <Translation>de_DE</Translation>
        <Translation>it_IT</Translation>
        <Translation>sv_SE</Translation>
        <Translation>fr_FR</Translation>
        <Translation>pl_PL</Translation>
    </Translations>
    <ControlScript>controller.js</ControlScript>
    <WizardDefaultWidth>700</WizardDefaultWidth>
    <WizardDefaultHeight>550</WizardDefaultHeight>
</Installer>
